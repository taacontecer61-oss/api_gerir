NODE_ENV=production
HOST=0.0.0.0
# Na Hostinger partilhada o painel injeta PORT. No VPS use a porta que o Nginx encaminha.
PORT=3001

# MySQL da Hostinger (hPanel → Bases de dados). No mesmo alojamento o host é localhost e a porta 3306.
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=u123456789_kwanza
DATABASE_PASSWORD=troque-esta-senha
DATABASE_NAME=u123456789_kwanza

# Mínimo 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-segredo-aleatorio-com-32-ou-mais-caracteres
SESSION_COOKIE_NAME=kn_session
SESSION_TTL_HOURS=12

# Origens do site público e do painel, sem barra no fim. Cookies de sessão exigem HTTPS.
CORS_ORIGIN=https://kwanzanews.ao,https://www.kwanzanews.ao,https://painel.kwanzanews.ao
SITE_URL=https://kwanzanews.ao
ADMIN_URL=https://painel.kwanzanews.ao

TIMEZONE=Africa/Luanda

# Obrigatórias na configuração mesmo depois do primeiro seed. Altere a senha no painel após o primeiro login.
SEED_ADMIN_EMAIL=admin@kwanzanews.ao
SEED_ADMIN_PASSWORD=ChangeMeNow!2026
SEED_ADMIN_NAME=Administrador

# Nginx / proxy da Hostinger: um salto.
TRUST_PROXY=1
DATABASE_POOL_SIZE=10
WEB_CONCURRENCY=1

# Opcional
# REDIS_URL=redis://127.0.0.1:6379
# CDN_BASE_URL=https://cdn.kwanzanews.ao
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=noreply@kwanzanews.ao
